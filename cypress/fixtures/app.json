      "trigger": "svg.lucide-calendar-days",
      "dayCell": "td[data-day=\"YYYY-MM-DD\"] button",
      "_note": "Pakai td[data-day] (exact, ISO). JANGAN pakai button[aria-label*=\"July 17\"] seperti qa-cazh — aria-label-nya nama bulan Inggris, pecah kalau UI diganti ke ID.",
      "_confidence": "verified"
    },
    "timeField": {
      "container": "[data-slot=\"datefield\"]",
      "hourSegment": "[data-slot=\"datefield\"] [data-type=\"hour\"]",
      "minuteSegment": "[data-slot=\"datefield\"] [data-type=\"minute\"]",
      "_note": "React Aria — bukan <input type=\"time\">. Diisi dengan .type('1230') ke container, atau per-segment. Format 24 jam, auto-cap ke 23:59.",
      "_confidence": "unverified"
    },
    "switch": {
      "selector": "button[role=\"switch\"]",
      "stateAttr": "data-state",
      "stateValues": ["checked", "unchecked"],
      "_note": "Cek state via data-state / aria-checked, bukan :checked (ini <button>, bukan <input>).",
      "_confidence": "unverified"
    },
    "dialogState": {
      "openSelector": "[role=\"dialog\"][data-state=\"open\"]",
      "_note": "Radix menyisakan node dialog saat animasi close; pakai [data-state=\"open\"] kalau butuh membedakan."
